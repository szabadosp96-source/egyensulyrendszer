<script>
  // ---------- Interactive model ----------
  const levelText = {
    oszt: {
      1:"Az állam nem ösztönzi és nem is szerez belőle bevételt.",
      2:"Az állam engedélyezi a működést, de nem ösztönzi aktívan.",
      3:"Az állam közvetlenül vagy közvetve bevételt szerez a tevékenységből.",
      4:"Az állam aktívan ösztönzi és jelentős bevételre támaszkodik belőle.",
      5:"A tevékenység az állami bevételek és politika szerves, ösztönzött része."
    },
    korr: {
      1:"Nincs rendszeres mérés vagy korrekciós mechanizmus.",
      2:"Az állam rendszeresen méri a negatív társadalmi következményeket és költségeket.",
      3:"Léteznek szabályok és programok, amelyek reagálnak a mért hatásokra.",
      4:"A korrekciós rendszer arányos forrásokkal és folyamatos felülvizsgálattal működik.",
      5:"A mérés, szabályozás és visszacsatolás teljesen összehangolt és arányos."
    }
  };

  const oszt = document.getElementById('oszt');
  const korr = document.getElementById('korr');
  const osztVal = document.getElementById('oszt-val');
  const korrVal = document.getElementById('korr-val');
  const osztDesc = document.getElementById('oszt-desc');
  const korrDesc = document.getElementById('korr-desc');
  const beamFill = document.getElementById('beam-fill');
  const beamMarker = document.getElementById('beam-marker');
  const verdict = document.getElementById('verdict');

  function updateModel(){
    const o = parseInt(oszt.value, 10);
    const k = parseInt(korr.value, 10);
    osztVal.textContent = o;
    korrVal.textContent = k;
    osztDesc.textContent = o + ". szint — " + levelText.oszt[o];
    korrDesc.textContent = k + ". szint — " + levelText.korr[k];

    const diff = o - k; // -4..4
    const pct = 50 + diff * 10; // marker position along beam, 10..90
    beamMarker.style.left = pct + '%';
    beamMarker.style.background = diff === 0 ? '#178A5D' : (Math.abs(diff) >= 3 ? '#B23A3A' : '#C4841A');

    if(diff >= 0){
      beamFill.style.left = '50%';
      beamFill.style.width = (pct - 50) + '%';
    } else {
      beamFill.style.left = pct + '%';
      beamFill.style.width = (50 - pct) + '%';
    }
    beamFill.style.background = diff === 0 ? '#178A5D' : (Math.abs(diff) >= 3 ? '#B23A3A' : '#C4841A');

    verdict.className = 'verdict';
    if(Math.abs(diff) <= 1){
      verdict.classList.add('verdict-balanced');
      verdict.textContent = 'A két oldal közel van egymáshoz. Ez a szemléltető modell szerint a rendszeregyensúly felé mutat.';
    } else if(Math.abs(diff) <= 2){
      verdict.classList.add('verdict-warn');
      verdict.textContent = diff > 0
        ? 'Az ösztönző oldal erősebb a korrekciós oldalnál — érdemes a mérési és korrekciós mechanizmusokat erősíteni.'
        : 'A korrekciós oldal erősebb az ösztönzésnél — a rendszer túlszabályozott lehet a tényleges kockázatokhoz képest.';
    } else {
      verdict.classList.add('verdict-strong');
      verdict.textContent = diff > 0
        ? 'Jelentős egyensúlytalanság: erős ösztönzés, gyenge korrekció. Ez a modell szerint magas kockázatú állapotot jelez.'
        : 'Jelentős egyensúlytalanság a korrekció javára: a szabályozás jóval erősebb, mint az ösztönzés mértéke indokolná.';
    }
  }

  oszt.addEventListener('input', updateModel);
  korr.addEventListener('input', updateModel);
  updateModel();

  // ---------- Area cards ----------
  document.querySelectorAll('.area-card').forEach(card => {
    function toggle(){
      const willOpen = !card.classList.contains('open');
      card.classList.toggle('open');
      const btn = card.querySelector('.area-toggle');
      btn.textContent = willOpen ? '×' : '+';
      btn.setAttribute('aria-label', willOpen ? 'Részletek bezárása' : 'Részletek megnyitása');
    }
    card.addEventListener('click', (e) => {
      if(e.target.tagName === 'A') return;
      toggle();
    });
    card.addEventListener('keydown', (e) => {
      if(e.key === 'Enter' || e.key === ' '){
        e.preventDefault();
        toggle();
      }
    });
  });

  // ---------- Signup demo ----------
  const signupForm = document.getElementById('signup-form');
  signupForm.addEventListener('submit', function(e){
    e.preventDefault();
    document.getElementById('signup-success').classList.add('show');
    signupForm.querySelectorAll('input').forEach(i => i.value = i.type === 'checkbox' ? false : '');
  });
</script>

<div class="cookie-banner" id="cookie-banner">
  <p>Ez a weboldal a működéséhez szükséges sütiket (cookie-kat) használ. Bővebben az <a href="adatvedelem/">Adatvédelmi tájékoztatóban</a> olvashatsz.</p>
  <div class="cookie-banner-actions">
    <button class="btn btn-primary" id="cookie-accept">Rendben</button>
  </div>
</div>

<script>
  (function(){
    var banner = document.getElementById('cookie-banner');
    var accept = document.getElementById('cookie-accept');
    if(!banner || !accept) return;
    if(!localStorage.getItem('cookie-consent')){
      setTimeout(function(){ banner.classList.add('show'); }, 500);
    }
    accept.addEventListener('click', function(){
      localStorage.setItem('cookie-consent', 'accepted');
      banner.classList.remove('show');
    });
  })();
</script>

